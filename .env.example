# Copy to .env. Defaults below are for LOCAL TESTING ONLY.
DB_PASSWORD=123456

# Signing key for access tokens: 32+ random characters. Generate one with:  openssl rand -base64 48
GATEKEEPER_JWT_SECRET=dev-only-secret-change-me-32-bytes-min!!
GATEKEEPER_JWT_TTL_MINUTES=60

# Passwords applied to the seeded platform-admin / gateway-service accounts at startup.
PLATFORM_ADMIN_PASSWORD=Admin@12345
GATEWAY_SERVICE_PASSWORD=Gateway@12345

# Creates tenant "demo-tenant" (Tenant@12345) with a sample route. Set to false in production.
GATEKEEPER_DEMO_DATA=true
